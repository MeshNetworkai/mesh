<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Hardened runtime, no App Sandbox: the app reads ~/.mesh/config.json, writes ~/.mesh/paused and
    spawns ~/.mesh/bin/mesh-node (a shell wrapper around Node). A sandboxed app could do none of
    that without a helper, so this is distributed outside the Mac App Store (Developer ID +
    notarisation). Nothing here needs a special entitlement; the file exists so `codesign` has
    one explicit, reviewable set.
  -->
  <key>com.apple.security.app-sandbox</key>
  <false/>
</dict>
</plist>
