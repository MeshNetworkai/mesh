# ---- gateway ----
PORT=8787
HOST=0.0.0.0
# sqlite file (created on boot)
MESH_DB_PATH=./data/mesh.db
# mock | chain   (mock = in-memory MockAdapter; chain = adapter for config/tokenomics.json "chain")
MESH_ADAPTER=mock
# secret for session JWTs (any long random string)
JWT_SECRET=change-me-to-a-long-random-string
# guards /admin/* endpoints
ADMIN_TOKEN=dev-admin-token
# optional: real upstream. Leave unset to use the offline MOCK upstream.
# OPENROUTER_API_KEY=sk-or-...
# cron for the distribution job (default: top of every hour). Set to "off" to disable.
EPOCH_CRON=0 * * * *
# rate limit on /v1 (requests per minute per API key / IP)
V1_RATE_LIMIT=120
# LOG_LEVEL=info

# ---- node-agent ----
GATEWAY_URL=http://localhost:8787
NODE_WALLET=mockwallet_node_1
NODE_URL=http://localhost:11434
NODE_MODELS=llama3.1:8b,qwen2.5:7b

# ---- production (session 2) ----
# NODE_ENV=production turns on geo-blocking (config.geoBlock) for /v1 and /auth; override with GEO_BLOCK_ENFORCE=true|false
# NODE_ENV=production
# domain shown in the wallet sign-in message and checked on /auth/verify (SIWE style)
AUTH_DOMAIN=localhost:8787
# AUTH_URI=https://api.yourdomain.com
# abort upstream calls after this long (ms); failures are 502 and never charged
UPSTREAM_TIMEOUT_MS=60000
# per-IP requests/minute across /auth/*
AUTH_RATE_LIMIT=20
# /stats cache (ms)
STATS_CACHE_MS=10000

# ---- security (session 5) ----
# Browser origins allowed by CORS, comma-separated. Dev default: any origin. Production default: none,
# so the web app's origin MUST be listed here or sign-in fails in the browser.
CORS_ORIGINS=http://localhost:5173
# Rotating JWT_SECRET: move the old value here, set the new one above, restart, delete this after 7 days.
# JWT_SECRET_PREVIOUS=
# /admin/dev-login is refused in production unless this is true (never in a real deployment).
# ALLOW_DEV_LOGIN=false
# Node operators must sign the registration challenge with their reward wallet (config/tokenomics.json
# nodes.requireSignature, default true). false = accept self-declared wallets (dev / demo only).
# NODES_REQUIRE_SIGNATURE=true
# Registrations per hour per IP on /nodes/register
NODE_REGISTER_RATE_LIMIT=10
# Max request body on /v1 in bytes (auth and node routes are capped at 16 KB regardless)
# BODY_LIMIT_BYTES=2097152

# ---- alerts (apps/gateway/src/alerts.ts) ----
# ALERTS_ENABLED=true
# ALERT_CHECK_INTERVAL_MS=60000
# Telegram delivery (both required, otherwise alerts only go to the log). Create a bot with @BotFather,
# add it to a group/channel, read the chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_DB_MAX_MB=1024
# ALERT_DISK_MIN_FREE_PCT=10

# ---- web (apps/web, Vite: variables must be prefixed VITE_) ----
# gateway base URL the browser talks to
VITE_API_URL=http://localhost:8787
# 1 = render with realistic fake data, no gateway needed
# VITE_MOCK=1
